# App settings
APP_NAME=AI Interview Agent
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# OpenAI / LLM configuration
# Leave OPENAI_API_KEY empty to use the built-in deterministic fallback.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT=60.0

# Interview flow
INTERVIEW_TURNS_BEFORE_FEEDBACK=5

