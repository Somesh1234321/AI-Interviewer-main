# ---------------------------------------------------------------------------
# AI Interview Agent — Backend Environment Configuration
# Copy this file to `.env` and fill in your values.
#
# On Render, these are set as Environment Variables in the dashboard instead
# of a `.env` file. The app also reads Render's injected `PORT` automatically.
# ---------------------------------------------------------------------------

# Application
APP_NAME=AI Interview Agent
APP_VERSION=0.1.0
APP_ENV=development

# Server binding (Render injects its own PORT automatically, overriding these)
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins.
# Add your Vercel frontend URL in production, e.g.:
#   https://your-app.vercel.app,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# OpenAI (optional)
# If omitted, the app falls back to a rule-based deterministic generator,
# so the API works even without a key. Set one to get adaptive AI questions.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-3.5-turbo

# Interview behaviour
INTERVIEW_TURNS_BEFORE_FEEDBACK=5
LLM_REQUEST_TIMEOUT=60.0
LLM_TEMPERATURE=0.7

